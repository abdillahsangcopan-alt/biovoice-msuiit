# ============================================================================
# BIOVOICE RESEARCH PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or configure in Netlify UI.
# NEVER commit actual .env files, API keys, or participant identity mappings.
# ============================================================================

# Server Configuration
PORT=4173
NODE_ENV=development

# Researcher & Teacher Dashboard Authentication Credentials
# Change these in your local .env or Netlify Environment Variables before deployment.
BIOVOICE_ADMIN_USER=researcher_admin
BIOVOICE_ADMIN_PASS=change_this_admin_password_in_env
BIOVOICE_TEACHER_USER=biology_teacher
BIOVOICE_TEACHER_PASS=change_this_teacher_password_in_env
BIOVOICE_SESSION_SECRET=change_this_random_64_char_secret_token

# Optional Class Session Access PIN (Leave blank to allow BV-code entry without PIN,
# or set a 4-6 digit PIN announced by the teacher in the intervention/comparison class)
BIOVOICE_CLASS_ACCESS_PIN=

# Optional External AI Provider Configuration (Gemini API / OpenAI Compatible)
# BioVoice works 100% free out-of-the-box using its expert-validated, curriculum-aligned
# Grade 11 Biology 1 engine. If an external LLM key is supplied below, /api/chat uses it
# under strict Appendix H guardrails and falls back to the validated knowledge base.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Central Cloud Database (Firebase Cloud Firestore REST / Supabase)
# Leave blank to use the built-in server-side JSON database in private_data/
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
